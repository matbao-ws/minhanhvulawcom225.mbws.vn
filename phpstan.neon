includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes

    # The baseline only shrinks. CI never regenerates it: when an entry is
    # fixed, this makes the run fail until the entry is deleted.
    reportUnmatchedIgnoredErrors: true

    tmpDir: storage/framework/cache/phpstan
